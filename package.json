{
  "name": "geld",
  "version": "4.1.0",
  "description": "geld is a minimal currency formatter.",
  "license": "MIT",
  "repository": "github:mrcgrtz/geld",
  "funding": [
    {
      "type": "kofi",
      "url": "https://ko-fi.com/mrcgrtz"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/mrcgrtz"
    }
  ],
  "author": "Marc Görtz <git@marcgoertz.de> (https://marcgoertz.de/)",
  "type": "module",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "coverage": "c8 report --reporter=lcov",
    "prepare": "husky",
    "test": "xo && tsd && c8 node --test"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "currency",
    "format"
  ],
  "devDependencies": {
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tsd": "^0.33.0",
    "xo": "^5.0.1"
  },
  "lint-staged": {
    "*.js": "xo --fix"
  },
  "tsd": {
    "directory": "test"
  },
  "xo": {
    "ignores": [
      "**/*.d.ts",
      "**/*.test-d.ts"
    ]
  }
}
